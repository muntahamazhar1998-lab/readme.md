def linear_search(lst, target):
    """
    Implement a linear search algorithm.

    Requirements:
    - Search the list from beginning to end.
    - Return the index if the target is found.
    - Return -1 if the target is not found.
    - Add comments explaining why linear search
      has O(n) time complexity.
    """
    for i in range(len(lst)):
        # Check each element sequentially
        if lst[i] == target:
            return i
            
    # Time Complexity: O(n)
    # Explanation: In the worst-case scenario (when the target is at the 
    # very end of the list or not present at all), linear search must inspect 
    # every single element one by one. Therefore, the number of operations 
    # grows directly in proportion to the input size (n).
    return -1


def binary_search(lst, target):
    """
    Implement a binary search algorithm.

    Requirements:
    - Assume the list is already sorted.
    - Repeatedly reduce the search space by half.
    - Return the index if the target is found.
    - Return -1 if the target is not found.
    - Add comments explaining how each iteration
      reduces the search space.
    """
    low = 0
    high = len(lst) - 1

    while low <= high:
        # Find the middle index
        mid = (low + high) // 2

        if lst[mid] == target:
            return mid
        elif lst[mid] < target:
            # Target must be in the right half.
            # Discard the left half and the current mid by moving 'low'.
            low = mid + 1
        else:
            # Target must be in the left half.
            # Discard the right half and the current mid by moving 'high'.
            high = mid - 1

    # Time Complexity: O(log n)
    # Explanation: In each iteration, the algorithm compares the target to 
    # the middle element and cuts the remaining search space in half. 
    # This exponential halving means even massive datasets require very few steps.
    return -1


